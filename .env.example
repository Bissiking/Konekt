PORT=3001
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3001
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_PATH=./db.sqlite

AUTH_PROVIDER=kyros
KYROS_SSO_VERSION=4.4.0
KYROS_EDITION=standard
KYROS_APPLICATION_SCOPE=standard
KYROS_ENTERPRISE_ENABLED=false

KYROS_BASE_URL=https://dev.api.mhemery.fr
KYROS_CLIENT_ID=
KYROS_CLIENT_SECRET=
KYROS_JWT_SECRET=
KYROS_ISSUER=kyros
KYROS_AUDIENCE=kyros-modules
KYROS_RESOURCE_AUDIENCE=kyros:sso:konekt
# Facultatif : surcharge PUBLIC_BASE_URL pour le callback si nécessaire.
# KYROS_REDIRECT_URI=http://localhost:3001/auth/callback
KYROS_REQUESTED_SCOPE=profile
KYROS_REQUIRED_SCOPES=profile

# Surcharges optionnelles
# KYROS_AUTHORIZE_URL=https://dev.api.mhemery.fr/authorize
# KYROS_TOKEN_URL=https://dev.api.mhemery.fr/token
# KYROS_USERINFO_URL=https://dev.api.mhemery.fr/userinfo
# KYROS_REVOKE_URL=https://dev.api.mhemery.fr/revoke
# KYROS_TIMEOUT_SECONDS=8
