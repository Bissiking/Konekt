{
  "name": "konekt",
  "version": "3.1.0",
  "description": "Konekt — disponibilités + chat en temps réel pour les équipes, SSO Kyros V4",
  "main": "backend/dist/server.js",
  "scripts": {
    "dev": "tsx watch backend/src/server.ts",
    "build": "tsc -p backend/tsconfig.json",
    "start": "node backend/dist/server.js",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit",
    "test": "npm run build && node --test backend/test/*.test.js",
    "check": "npm run typecheck && npm test"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "dotenv": "^16.6.0",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "multer": "^2.2.0",
    "socket.io": "^4.8.1"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
